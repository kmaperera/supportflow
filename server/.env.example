NODE_ENV=development
PORT=5000

# Optional overrides; defaults: 15 minutes, 5000 in development / 1000 otherwise.
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=1000

# Login failures: enabled in all environments, separate from the general quota.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=supportflow

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Exact frontend origin shared by REST and Socket.IO. Production requires it.
# No paths, wildcards, credentials, query or fragment. A trailing slash is OK.
CLIENT_URL=http://localhost:5173

# Cloudinary (required when the Cloudinary client is loaded)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=SupportFlow
EMAIL_FROM_ADDRESS=

# Initial administrator
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
