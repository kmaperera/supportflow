NODE_ENV=development
PORT=5000

# Optional overrides; defaults: 15 minutes, 5000 in development / 1000 otherwise.
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=1000

# Login failures: enabled in all environments, separate from the general quota.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=supportflow
# Optional verified TLS for remote MySQL; keep false for local development.
DB_SSL=false
# Optional provider PEM CA bundle (actual newlines or literal \n); server-only.
# When absent, DB_SSL=true uses the system trusted CA roots. Never disable verification.
DB_SSL_CA=

# Production requires distinct, cryptographically random secrets (32+ characters).
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
PASSWORD_RESET_TTL_MINUTES=15
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Exact frontend origin shared by REST and Socket.IO. Production requires it.
# No paths, wildcards, credentials, query or fragment. A trailing slash is OK.
CLIENT_URL=http://localhost:5173

# Cloudinary (required at server startup)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional email: leave the whole group blank to disable; fill every required field to enable.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=SupportFlow
EMAIL_FROM_ADDRESS=

# Initial administrator
INITIAL_ADMIN_FIRST_NAME=your_first_name
INITIAL_ADMIN_LAST_NAME=your_last_name
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=replace_with_unique_admin_password
