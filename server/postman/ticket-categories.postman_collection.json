{
  "info": {
    "name": "16.8 Backend Support - Ticket Categories",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set adminToken and nonAdminToken from normal login. Run in order against a test database. Creates one category and leaves it active; no deletion endpoint exists."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "nonAdminToken",
      "value": ""
    },
    {
      "key": "categoryName",
      "value": "Phase16.8-Test-Category"
    },
    {
      "key": "categoryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "16.8 Backend Support - Ticket Categories",
      "item": [
        {
          "name": "Admin list",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/admin/categories",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tickets/admin/categories",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{categoryName}}\",\"description\":\"Phase 16.8 test\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201) pm.collectionVariables.set('categoryId',pm.response.json().data.category.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/admin/categories/{{categoryId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tickets/admin/categories",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\" {{categoryName}} \"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/tickets/admin/categories/{{categoryId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Updated test\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/tickets/admin/categories/{{categoryId}}/status",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"isActive\":false}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup excludes inactive",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/categories",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(200));",
                  "pm.test('Inactive hidden',()=>pm.expect(pm.response.json().data.categories.some(c=>String(c.id)===String(pm.collectionVariables.get('categoryId')))).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin includes inactive",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/admin/categories",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(200));",
                  "pm.test('Inactive retained',()=>pm.expect(pm.response.json().data.categories.find(c=>String(c.id)===String(pm.collectionVariables.get('categoryId'))).isActive).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reactivate",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/tickets/admin/categories/{{categoryId}}/status",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"isActive\":true}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-admin forbidden",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/admin/categories",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{nonAdminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/admin/categories/invalid",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/admin/categories/18446744073709551615",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid payload",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tickets/admin/categories",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\" \",\"id\":1}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status',()=>pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}